    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Página no encontrada / Page not found – Nico Pusso</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@200;400&display=swap" />
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-content: center; gap: 24px; padding: 20px; background: #fff; color: #1d1d1d; font-family: 'Playfair Display', Georgia, serif; text-align: center; }
      h1 { margin: 0; font-weight: 200; font-size: clamp(40px, 8vw, 70px); line-height: 1; letter-spacing: -3px; text-transform: uppercase; }
      p { margin: -12px 0 0; font-size: 25px; letter-spacing: -1.3px; color: #9a9a9a; }
      a { color: inherit; font-size: 25px; letter-spacing: -1.3px; }
