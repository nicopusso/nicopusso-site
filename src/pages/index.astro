---
import { Image } from 'astro:assets';
import meSubi from '../assets/weekly-random/me-subi-al-auto-de-un-extrano.jpg';
import pescador from '../assets/weekly-random/pescador-o-cardiologo.png';
import diedrich from '../assets/weekly-random/diedrich-knickerbocker.png';

// Weekly Random lives on porto.works. These are the latest three notes;
// update this list when a new one is published there.
const WR = 'https://www.porto.works/weekly-random/';
// Mailchimp audience "Mailers", form "Embedded Signup Form". The page
// posts to the JSON endpoint (see the script at the bottom) so people
// subscribe without leaving the site; without JS it falls back to a
// regular post that opens Mailchimp's confirmation page.
const MC_U = 'ab1263e5cfe2f1276935eb593';
const MC_ID = 'e55d6d7870';
const MC_FID = '00fec2e1f0';
const MC_ACTION = `https://list-manage.us18.list-manage.com/subscribe/post?u=${MC_U}&id=${MC_ID}&f_id=${MC_FID}`;
const MC_HONEYPOT = `b_${MC_U}_${MC_ID}`;

const notas = [
  {
    slug: 'me-subi-al-auto-de-un-extrano',
    title: 'Me subí al auto de un extraño',
    excerpt:
      'Son las nueve y pico de la mañana y llueve en Río de Janeiro. Una de esas lluvias molestas que no parecen gran cosa hasta que te das cuenta de que estás empapado.',
    cover: meSubi,
  },
  {
    slug: 'pescador-o-cardiologo',
    title: 'Pescador o Cardiólogo',
    excerpt:
      'Hace unas semanas estuve en los Hamptons trabajando con una organización de polo y pasó lo que me pasa cuando me acerco lo suficiente a un mundo nuevo.',
    cover: pescador,
  },
  {
    slug: 'diedrich-knickerbocker',
    title: 'Diedrich Knickerbocker',
    excerpt:
      'En octubre de 1809 en Nueva York, de repente empezaron a aparecer en todos los diarios de la ciudad avisos de personas buscando a un hombre.',
    cover: diedrich,
  },
];

const proyectos = [
  { name: 'Porto Works', href: 'https://www.porto.works/' },
  { name: 'Timewalls', href: 'https://timewalls.studio/' },
  { name: 'Weekly Random', href: WR },
];

const title = 'Nico Pusso – Brand Strategist';
const description =
  'Consultor de branding con más de 16 años de experiencia en construcción, posicionamiento y comunicación de marca.';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.site} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site} />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500&family=Playfair+Display:wght@400..900&family=Work+Sans:wght@600&display=swap"
    />
  </head>
  <body id="top">
    <header class="site-header">
      <a href="/" class="logo" aria-label="Nico Pusso">
        <img src="/logo.svg" alt="Nico Pusso" width="144" height="20" />
      </a>
      <a href={WR} class="header-link">Newsletter</a>
    </header>

    <main>
      <p class="hero">
        Soy consultor de branding con más de 16 años de experiencia acompañando procesos de construcción,
        posicionamiento y comunicación de marca. Co-fundé Timewalls, una galería de fotos centrada en
        storytelling, y Porto Works, una consultora de estrategia y branding donde colaboramos junto a
        otros estudios y profesionales.
      </p>

      <section class="section">
        <h2 class="label">WHAT I DO</h2>
        <ol class="proyectos">
          {
            proyectos.map((p, i) => (
              <li>
                <span class="num">{String(i + 1).padStart(2, '0')}</span>
                <a href={p.href}>
                  <span class="name">{p.name}</span>
                  <svg class="arrow" viewBox="0 0 40 40" aria-hidden="true">
                    <path d="M9 31 31 9M13 9h18v18" fill="none" stroke="currentColor" stroke-width="2" />
                  </svg>
                </a>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="section">
        <h2 class="label"><a href={WR}>Weekly Random - SUSCRIBITE</a></h2>
        <div class="cards">
          {
            notas.map((n) => (
              <a class="card" href={`${WR}${n.slug}/`}>
                <Image src={n.cover} alt="" widths={[480, 960]} sizes="(max-width: 767px) 100vw, 33vw" />
                <h3>{n.title}</h3>
                <p>{n.excerpt}</p>
              </a>
            ))
          }
        </div>
      </section>

      <section class="contact">
        <h2 class="label contact-label">OPEN FOR BUSINESS</h2>
        <div class="contact-body">
          <p class="contact-title">Nuevos proyectos? Escribime.</p>
          <div class="contact-cols">
            <div>
              <h2 class="label">email</h2>
              <a class="contact-big" href="mailto:nico@porto.works">nico@porto.works</a>
            </div>
            <div>
              <h2 class="label">INSTAGRAM</h2>
              <a class="contact-big" href="https://www.instagram.com/nicopusso/">@nicopusso</a>
            </div>
          </div>
          <h2 class="label">sigamos en contacto directo</h2>
          <p class="contact-sub">Recibí mi newsletter “Weekly Random”</p>
          <form class="subscribe" action={MC_ACTION} method="post" target="_blank" novalidate>
            <label class="visually-hidden" for="wr-email">Tu email</label>
            <input
              class="subscribe-field"
              id="wr-email"
              type="email"
              name="EMAIL"
              placeholder="Email"
              autocomplete="email"
              required
            />
            <div class="honeypot" aria-hidden="true">
              <input type="text" name={MC_HONEYPOT} tabindex="-1" value="" />
            </div>
            <button class="subscribe-button" type="submit">Suscribirme</button>
          </form>
          <p class="subscribe-msg" role="status" aria-live="polite"></p>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <span>No rights reserved.</span>
      <a href="#top">Back to top</a>
    </footer>

    <script>
      // Subscribe through Mailchimp's JSONP endpoint and show the result
      // in place. Mailchimp answers in Spanish (audience language).
      const form = document.querySelector<HTMLFormElement>('.subscribe');
      const msg = document.querySelector<HTMLElement>('.subscribe-msg');

      if (form && msg) {
        const input = form.querySelector<HTMLInputElement>('input[name="EMAIL"]')!;
        const button = form.querySelector<HTMLButtonElement>('button')!;

        const show = (text: string, state: 'ok' | 'error' | 'busy') => {
          msg.textContent = text;
          msg.dataset.state = state;
        };

        const friendly = (raw: string) => {
          const text = raw.replace(/<[^>]*>/g, '').replace(/^\d+\s*-\s*/, '').trim();
          if (/ya est|already/i.test(text)) return 'Ese mail ya está suscripto. Nos leemos en la próxima.';
          if (/demasiad|too many/i.test(text)) return 'Hubo muchos intentos con ese mail. Probá de nuevo en unos minutos.';
          return text || 'No pudimos suscribirte. Revisá el mail y probá de nuevo.';
        };

        form.addEventListener('submit', (event) => {
          event.preventDefault();

          if (!input.value.trim() || !input.checkValidity()) {
            show('Escribí un email válido.', 'error');
            input.focus();
            return;
          }

          const callback = `mc_cb_${Date.now()}`;
          const params = new URLSearchParams(new FormData(form) as unknown as Record<string, string>);
          params.set('c', callback);
          const url = form.action.replace('/subscribe/post?', '/subscribe/post-json?') + '&' + params.toString();

          const script = document.createElement('script');
          const cleanup = () => {
            delete (window as any)[callback];
            script.remove();
            button.disabled = false;
          };
          const timer = window.setTimeout(() => {
            cleanup();
            show('No pudimos conectarnos. Probá de nuevo en un rato.', 'error');
          }, 12000);

          (window as any)[callback] = (data: { result: string; msg: string }) => {
            window.clearTimeout(timer);
            cleanup();
            if (data.result === 'success') {
              form.reset();
              show(
                /confirm/i.test(data.msg)
                  ? 'Listo. Te llega un mail para confirmar la suscripción.'
                  : 'Listo, ya estás suscripto a Weekly Random.',
                'ok'
              );
            } else {
              show(friendly(data.msg), 'error');
            }
          };

          button.disabled = true;
          show('Enviando…', 'busy');
          script.src = url;
          script.onerror = () => {
            window.clearTimeout(timer);
            cleanup();
            show('No pudimos conectarnos. Probá de nuevo en un rato.', 'error');
          };
          document.body.appendChild(script);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --fg: #1d1d1d;
    --serif: 'Playfair Display', Georgia, serif;
    --label: 'Montserrat', Helvetica, Arial, sans-serif;
    --card-title: 'Work Sans', Helvetica, Arial, sans-serif;
    --num: 'Times New Roman', Times, serif;
    --pad: 29px;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: #fff;
    color: var(--fg);
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  h2,
  h3,
  p,
  ol {
    margin: 0;
  }
</style>

<style>
  /* Header */
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 46px;
    margin: 0 var(--pad);
    padding: 0 10px;
    border-bottom: 1px solid var(--fg);
  }

  .logo img {
    width: 144px;
  }

  .header-link {
    font-family: var(--serif);
    font-size: 25px;
    line-height: 25px;
    letter-spacing: -1.3px;
  }

  /* Hero */
  .hero {
    padding: 29px var(--pad) 0;
    font-family: var(--serif);
    font-weight: 200;
    font-size: 70px;
    line-height: 58px;
    letter-spacing: -3px;
    text-transform: uppercase;
    max-width: calc(1313px + 2 * var(--pad));
  }

  /* Section labels */
  .label {
    font-family: var(--label);
    font-weight: 500;
    font-size: 10px;
    line-height: 10px;
  }

  .section {
    margin-top: 256px;
    padding: 0 var(--pad);
  }

  .section + .section {
    margin-top: 150px;
  }

  /* What I do */
  .proyectos {
    list-style: none;
    padding: 0;
    margin-top: 17px;
  }

  .proyectos li {
    position: relative;
    display: flex;
    align-items: flex-end;
    border-bottom: 1px solid var(--fg);
    padding: 0 0 15px 49px;
    margin-bottom: 23px;
  }

  .num {
    position: absolute;
    left: 20px;
    bottom: 20px;
    font-family: var(--num);
    font-size: 31px;
    line-height: 31px;
    letter-spacing: -5px;
  }

  /* The whole row is the link. On hover the name slides right and an
     arrow comes in at the end of the row; on touch screens the arrow is
     always visible so the rows still read as links. */
  .proyectos a {
    flex: 1;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    font-family: var(--serif);
    font-size: 70px;
    line-height: 65px;
    letter-spacing: -5px;
    text-transform: uppercase;
    --ease: cubic-bezier(0.22, 0.75, 0.2, 1);
  }

  .name {
    display: inline-block;
    transition: transform 0.5s var(--ease);
  }

  .arrow {
    flex: none;
    width: 44px;
    height: 44px;
    margin-bottom: 8px;
    opacity: 0;
    transform: translate(-18px, 18px);
    transition:
      opacity 0.35s ease,
      transform 0.5s var(--ease);
  }

  .proyectos li::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--fg);
    transform: scaleY(1);
    transform-origin: bottom;
    transition: transform 0.35s ease;
  }

  @media (hover: hover) {
    .proyectos a:hover .name,
    .proyectos a:focus-visible .name {
      transform: translateX(18px);
    }

    .proyectos a:hover .arrow,
    .proyectos a:focus-visible .arrow {
      opacity: 1;
      transform: translate(0, 0);
    }

    .proyectos li:hover::after,
    .proyectos li:focus-within::after {
      transform: scaleY(3);
    }
  }

  @media (hover: none) {
    .arrow {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .name,
    .arrow,
    .proyectos li::after {
      transition: opacity 0.2s ease;
    }

    .proyectos a:hover .name,
    .proyectos a:focus-visible .name {
      transform: none;
    }

    .proyectos a:hover .arrow,
    .proyectos a:focus-visible .arrow {
      transform: none;
    }
  }

  /* Weekly Random cards */
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    margin: 19px -14px 0;
  }

  .card img {
    width: 100%;
    aspect-ratio: 1270 / 1496;
    object-fit: cover;
  }

  .card h3 {
    margin: 19px 14px 10px;
    font-family: var(--card-title);
    font-weight: 600;
    font-size: 20px;
    line-height: 24px;
    letter-spacing: -2.2px;
    color: #000;
  }

  .card p {
    margin: 0 14px;
    font-family: var(--serif);
    font-weight: 400;
    font-size: 14px;
    line-height: 19px;
    color: #000;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card:hover h3 {
    opacity: 0.6;
  }

  /* Contact */
  .contact {
    display: grid;
    grid-template-columns: 400px minmax(0, 1fr);
    margin-top: 170px;
    padding: 0 var(--pad) 0 calc(var(--pad) + 10px);
  }

  .contact-label {
    padding-top: 10px;
  }

  .contact-title {
    font-family: var(--serif);
    font-size: 50px;
    line-height: 43px;
    letter-spacing: -5px;
    text-transform: uppercase;
    max-width: 814px;
  }

  .contact-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 49px 0 44px;
    max-width: 958px;
  }

  /* Email and Instagram: an underline draws in from the left on hover
     (always visible, thinner, on touch screens). */
  .contact-big {
    display: inline-block;
    padding-bottom: 4px;
    font-family: var(--serif);
    font-size: 35px;
    line-height: 35px;
    letter-spacing: -3px;
    background: linear-gradient(currentColor, currentColor) left bottom / 0% 1px no-repeat;
    transition: background-size 0.45s cubic-bezier(0.22, 0.75, 0.2, 1);
  }

  @media (hover: hover) {
    .contact-big:hover,
    .contact-big:focus-visible {
      background-size: 100% 1px;
    }
  }

  @media (hover: none) {
    .contact-big {
      background-size: 100% 1px;
    }
  }

  .contact-sub {
    margin-top: 4px;
    font-family: var(--serif);
    font-size: 35px;
    line-height: 35px;
    letter-spacing: -3px;
    text-transform: uppercase;
    max-width: 814px;
  }

  .subscribe {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 17px;
    max-width: 586px;
  }

  .subscribe-field {
    flex: 1;
    min-width: 0;
    padding: 10px 14px;
    border: 0;
    border-bottom: 1px solid #69727d;
    border-radius: 0;
    background: transparent;
    font-family: var(--serif);
    font-size: 19px;
    line-height: 19px;
    letter-spacing: -0.9px;
    color: var(--fg);
    transition: border-color 0.25s ease;
  }

  .subscribe-field::placeholder {
    color: #69727d;
    opacity: 1;
  }

  .subscribe-field:focus {
    outline: none;
    border-bottom-color: var(--fg);
  }

  .subscribe-button {
    padding: 10px 0;
    border: 0;
    background: none;
    cursor: pointer;
    font-family: var(--num);
    font-size: 24px;
    line-height: 24px;
    font-weight: 500;
    letter-spacing: -1.3px;
    color: #000;
    transition: opacity 0.25s ease;
  }

  .subscribe-button:hover,
  .subscribe-button:focus-visible {
    opacity: 0.6;
  }

  .subscribe-button:disabled {
    opacity: 0.4;
    cursor: wait;
  }

  .subscribe-msg {
    min-height: 19px;
    margin-top: 12px;
    max-width: 586px;
    font-family: var(--serif);
    font-size: 16px;
    line-height: 19px;
    letter-spacing: -0.4px;
  }

  .subscribe-msg[data-state='error'] {
    color: #b3261e;
  }

  .subscribe-msg[data-state='busy'] {
    color: #69727d;
  }

  .honeypot {
    position: absolute;
    left: -5000px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* Footer */
  .site-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 46px;
    margin: 120px var(--pad) 0;
    padding: 0 10px;
    border-top: 1px solid #444;
    font-family: var(--serif);
    font-size: 25px;
    line-height: 25px;
    letter-spacing: -1.3px;
  }

  /* Tablet */
  @media (max-width: 1024px) {
    .hero {
      padding-left: 20px;
      padding-right: 20px;
    }

    .section {
      padding: 0 20px;
    }

    .num {
      display: none;
    }

    .proyectos li {
      padding-left: 10px;
    }

    .contact {
      grid-template-columns: 290px minmax(0, 1fr);
    }
  }

  /* Mobile */
  @media (max-width: 767px) {
    .site-header {
      margin: 0 8px;
      padding: 0 12px;
      height: 64px;
    }

    .logo img {
      width: 158px;
    }

    .header-link {
      font-size: 20px;
    }

    .hero {
      padding: 14px 8px 0;
      font-size: 40px;
      line-height: 40px;
    }

    .section {
      margin-top: 128px;
      padding: 0 8px;
    }

    .proyectos li {
      margin-bottom: 37px;
    }

    .proyectos a {
      font-size: 45px;
    }

    .proyectos a {
      gap: 6px;
    }

    .arrow {
      width: 22px;
      height: 22px;
      margin-bottom: 14px;
    }

    .cards {
      grid-template-columns: 1fr;
      gap: 40px;
      margin: 24px -3px 0;
    }

    .card h3,
    .card p {
      margin-left: 3px;
      margin-right: 3px;
    }

    .contact {
      display: block;
      margin-top: 128px;
      padding: 0 8px;
    }

    .contact-label {
      padding: 0 0 14px;
    }

    .contact-title {
      font-size: 25px;
      line-height: 25px;
      letter-spacing: -2.6px;
    }

    .contact-cols {
      display: block;
      margin: 35px 0 45px;
    }

    .contact-cols > div + div {
      margin-top: 35px;
    }

    .contact-big {
      font-size: 25px;
      line-height: 25px;
      letter-spacing: -1.1px;
    }

    .contact-sub {
      font-size: 25px;
      line-height: 25px;
      letter-spacing: -2.6px;
    }

    .site-footer {
      margin: 60px 10px 0;
      padding: 0;
      font-size: 20px;
    }
  }
</style>
